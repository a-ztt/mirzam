# Database
# SQLite for local dev:
DATABASE_URL="file:./prisma/dev.db"

# Admin auth (MVP)
ADMIN_USER="admin"
ADMIN_PASSWORD="change_me"
# Long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET="change_me"
# Optional: set to "false" only when running over plain HTTP (e.g., temporary IP access).
# Keep as "true" for HTTPS.
AUTH_COOKIE_SECURE="true"

# Uploads
# Relative path is resolved from project root.
UPLOAD_DIR="./uploads"

# Site
# Public base URL for canonical links, sitemap, robots.txt and JSON-LD.
# Falls back to https://mirzam.kz when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
