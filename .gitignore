*.tsbuildinfo

# Local audit artifacts (генерируются скриптами, не нужны в git)
# Сами scripts/ оставляем — их полезно сохранить для будущих ре-аудитов.
/data/audit/*.csv
/data/audit/*.sql
# DEPLOY.md в data/audit/ оставляем — он часть документации.
!/data/audit/DEPLOY.md
