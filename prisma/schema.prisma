generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  sku           String?
  catalogNumber String?
  unit          String?
  qty           Int?
  priceKzt      Int?
  condition     String         @default("new")
  fits          Json           @default("[]")
  description   String?
  category      String?
  brand         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  images        ProductImage[]

  @@index([isActive])
  @@index([category])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model Unit {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  path      String   // relative path inside UPLOAD_DIR
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@unique([productId, path])
}

model Review {
  id          String   @id @default(cuid())
  authorName  String
  text        String
  rating      Int      @default(5)
  type        String   @default("site") // "site" or "product"
  productSlug String?
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([productSlug])
  @@index([isApproved])
}
